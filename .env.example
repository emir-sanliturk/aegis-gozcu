# Aegis Gözcü — Yerel Geliştirme Ortam Şablonu
# Bu dosyayı kopyalayarak .env oluşturun; gerçek gizli anahtarları asla repoya eklemeyin.

# Frontend API origin (boş bırakılırsa ağ isteği yapılmaz ve dürüst boş durum korunur)
VITE_AEGIS_API_ORIGIN=

# Backend Cloud Correlator ayarları
NODE_ENV=development
PORT=8080

# Açık CORS origin listesi (credentials: include ile * kullanılamaz)
AEGIS_ALLOWED_ORIGINS=http://localhost:5173

# En az 32 karakterlik rastgele değerler ile değiştirin
AEGIS_SESSION_SECRET=replace-with-a-long-random-session-secret-min-32-chars
AEGIS_IP_PEPPER=replace-with-a-long-random-ip-pepper-min-32-chars

# PostgreSQL bağlantı şablonu (gerçek parola repoya yazılmaz)
DATABASE_URL=postgresql://aegis_app:replace-with-a-strong-password@localhost:5432/aegis
